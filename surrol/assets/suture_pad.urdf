<?xml version="1.0"?>
<robot name="suture_pad">
    <material name="suture_pad_material">
        <color rgba="0.2 0.8 0.2 0.5"/>
    </material>

    <link name="baseLink">
        <contact>
            <lateral_friction value="1.0"/>
        </contact>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="suture_pad.glb" scale="0.04 0.04 0.04"/>
            </geometry>
            <material name="suture_pad_material"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="suture_pad.obj" scale="0.04 0.04 0.04"/>
            </geometry>
        </collision>
    </link>
</robot>

